# dgml-compass environment. Copy to .env (gitignored) and fill in. `dgc` loads ./.env, then
# models/.env, at start-up (or the file given with --env-file). A variable already set in
# your shell always wins; an empty value is ignored, so blank placeholders are harmless.
# dgml inherits this environment, which is how the provider keys reach it.

# -- Provider API keys (read by dgml, never by dgc, never written to any run artifact) ----
# Only the providers of the models a spec uses are needed.
ANTHROPIC_API_KEY=        # anthropic/claude-*            https://console.anthropic.com/
GEMINI_API_KEY=           # gemini/gemini-*               https://aistudio.google.com/apikey
OPENAI_API_KEY=           # openai/gpt-*                  https://platform.openai.com/api-keys

# -- Optional: dgc settings (same as local.yaml keys, upper-cased, DGC_ prefix) -----------
# These beat local.yaml and lose to command-line flags. Leave empty to use the profile/defaults.
DGC_DGML_REPO=            # e.g. ~/src/dgml
DGC_CORPUS_ROOT=
DGC_PRICES_FILE=
DGC_RUNS_DIR=
DGC_WORK_DIR=
DGC_MAX_PARALLEL_CELLS=
DGC_MAX_PARALLEL_CALLS=
DGC_BUDGET_USD=
