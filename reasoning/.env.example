# dgml-compass reasoning/ -- environment. Copy to .env (gitignored) and fill in.
# Only the endpoint and the key come from here; every other run parameter
# (model, client, reasoning effort, temperature, max tokens, prompt budget)
# is recorded in configs/experiments.json and set by `dgr run <experiment>`,
# which reads this file.
# Nothing in this file is written to any result.

# -- Reference backend: a DeepSeek deployment on Azure AI Foundry (stdlib client) --
AZURE_OPENAI_ENDPOINT=      # https://<resource>.<region>.models.ai.azure.com or your Azure OpenAI resource
AZURE_OPENAI_API_KEY=

# -- Any OpenAI-compatible endpoint (LLM_CLIENT=raw) or a litellm provider (LLM_CLIENT=litellm) --
# Set the backend in configs/experiments.json; put the matching key here, e.g.
# OPENAI_API_KEY=            # openai/*
# ANTHROPIC_API_KEY=         # anthropic/*
# LLM_API_BASE=              # a self-hosted /v1 endpoint (ollama, vllm, ...)
